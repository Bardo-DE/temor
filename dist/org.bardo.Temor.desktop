[Desktop Entry]
Type=Application
Version=1.0
Name=temor
Comment=The desktop's terminal
Exec=temor
Icon=org.bardo.Temor
Terminal=false
Categories=TerminalEmulator;System;
StartupWMClass=org.bardo.Temor
StartupNotify=true
# `temor -e program args…` runs a program in a tab of its own (xdg-terminal-exec).
X-TerminalArgExec=-e
DBusActivatable=true
# keycap passes ⌘ through as Super: temor reads the keymap itself, so ⌘D and ⌘⇧D stay apart.
X-Keycap-Profile=keymap-aware
